# 3) Create SparkSession
from pyspark.sql import SparkSession
from pyspark.sql.functions import col
import matplotlib.pyplot as plt

spark = SparkSession.builder.appName("IoT Big Data Exercise").getOrCreate()

# =========================
# 4) Read CSV or JSON file
# =========================

file_path = "/content/csv_json-20251229-2143.csv"
file_type = "csv"

if file_type == "csv":
    df = spark.read.csv(file_path, header=True, inferSchema=True)
elif file_type == "json":
    df = spark.read.json(file_path)
else:
    raise ValueError("file_type must be csv or json")

df.printSchema()
df.show(5)

from pyspark.sql.functions import regexp_extract, col, concat_ws

# מאחדים את כל העמודות לטקסט אחד כדי לחלץ גם humidity ו-soil
df_text = df.withColumn(
    "all_text",
    concat_ws(" ", col("value"), col("feed_id"), col("created_at"), col("lat"), col("lon"), col("ele"))
)

df2 = df_text.select(
    regexp_extract(col("all_text"), r'temperature["]*\s*:\s*([0-9.]+)', 1).cast("double").alias("temperature"),
    regexp_extract(col("all_text"), r'humidity["]*\s*:\s*([0-9.]+)', 1).cast("double").alias("humidity"),
    regexp_extract(col("all_text"), r'soil["]*\s*:\s*([0-9.]+)', 1).cast("double").alias("soil")
)

df2.show(5)

sensor_columns = ["temperature", "humidity", "soil"]

for sensor in sensor_columns:

    sensor_rdd = (
        df2.select(sensor)
        .rdd
        .filter(lambda row: row[sensor] is not None)
        .map(lambda row: (sensor, row[sensor]))
    )

    collected = sensor_rdd.collect()

    if len(collected) == 0:
        print(f"\n{sensor}: No valid values")
        continue

    max_value = sensor_rdd.reduceByKey(lambda a, b: max(a, b)).collect()[0][1]
    min_value = sensor_rdd.reduceByKey(lambda a, b: min(a, b)).collect()[0][1]

    print(f"\n{sensor}")
    print(f"Minimum = {min_value}")
    print(f"Maximum = {max_value}")

