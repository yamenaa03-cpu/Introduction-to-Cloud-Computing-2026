# =====================================================
# 1) FIREBASE CONFIG
# =====================================================

FIREBASE_DB_URL = "https://smart-tomato-care-default-rtdb.firebaseio.com"
SENSOR_HISTORY_PATH = f"{FIREBASE_DB_URL}/sensor_history.json"

# =====================================================
# 2) SPARK SESSION - BIG DATA ENGINE
# =====================================================

spark = SparkSession.builder \
    .appName("Plant Health Big Data Dashboard") \
    .getOrCreate()

# =====================================================
# 3) LOAD DATA FROM FIREBASE
# =====================================================

def load_sensor_history(limit=50):
    try:
        response = requests.get(SENSOR_HISTORY_PATH, timeout=20)
        data = response.json()

        if not data:
            return []

        samples = list(data.values())
        samples.sort(key=lambda x: x.get("sensor_timestamp", ""))

        return samples[-limit:]

    except Exception as e:
        print("Firebase load error:", e)
        return []

def to_float(value):
    try:
        return float(value)
    except:
        return None

# =====================================================
# 4) BIG DATA ANALYSIS WITH SPARK + MAPREDUCE
# =====================================================

def calc_stats(samples, field):
    clean_samples = []

    for s in samples:
        val = to_float(s.get(field))
        if val is not None:
            clean_samples.append((field, val))

    if not clean_samples:
        return {
            "latest": "N/A",
            "avg": "N/A",
            "min": "N/A",
            "max": "N/A"
        }

    # MAP step:
    # Convert each sensor reading into (sensor_name, value)
    rdd = spark.sparkContext.parallelize(clean_samples)

    # REDUCE step for MAX
    max_value = rdd.reduceByKey(lambda a, b: max(a, b)).collect()[0][1]

    # REDUCE step for MIN
    min_value = rdd.reduceByKey(lambda a, b: min(a, b)).collect()[0][1]

    # Average using Spark
    values_rdd = rdd.map(lambda x: x[1])
    avg_value = values_rdd.sum() / values_rdd.count()

    latest_value = clean_samples[-1][1]

    return {
        "latest": round(latest_value, 2),
        "avg": round(avg_value, 2),
        "min": round(min_value, 2),
        "max": round(max_value, 2)
    }

# =====================================================
# 5) PLANT CARE AGENT LOGIC
# =====================================================

def plant_care_agent(temp, humidity, soil):
    """
    Agent logic:
    The agent receives sensor data, analyzes the plant condition,
    calculates a risk score, decides the plant status,
    and returns reasons + suggested actions.
    """

    risk = 0
    reasons = []
    actions = []

    # Analyze temperature
    if temp != "N/A":
        if temp >= 35:
            risk += 35
            reasons.append("High temperature detected.")
            actions.append("Move the plant to a cooler place or improve ventilation.")
        elif temp >= 32:
            risk += 20
            reasons.append("Temperature is slightly high.")
            actions.append("Monitor the temperature more frequently.")

    # Analyze humidity
    if humidity != "N/A":
        if humidity < 35:
            risk += 25
            reasons.append("Humidity is low.")
            actions.append("Increase air humidity around the plant.")
        elif humidity > 85:
            risk += 20
            reasons.append("Humidity is too high.")
            actions.append("Improve airflow to prevent fungal diseases.")

    # Analyze soil moisture
    if soil != "N/A":
        if soil < 30:
            risk += 35
            reasons.append("Soil moisture is very low.")
            actions.append("Water the plant immediately.")
        elif soil < 45:
            risk += 20
            reasons.append("Soil moisture is dropping.")
            actions.append("Check if watering is needed soon.")

    risk = min(risk, 100)

    if risk < 30:
        status = "Healthy"
        icon = "🟢"
        color = "#16a34a"
        reasons = reasons or ["Sensor readings are within a normal range."]
        actions = actions or ["Continue regular monitoring."]
    elif risk < 60:
        status = "Needs Attention"
        icon = "🟠"
        color = "#f97316"
    else:
        status = "High Risk"
        icon = "🔴"
        color = "#dc2626"

    return risk, status, icon, color, reasons, actions

